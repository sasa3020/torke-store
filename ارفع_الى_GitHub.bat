@echo off
chcp 65001 > nul
title رفع متجر تورك إلى GitHub
cls
echo =========================================================
echo       جاري رفع متجر تورك ستور إلى مستودع GitHub
echo       https://github.com/sasa3020/torke-store
echo =========================================================
echo.

git add -A
git commit -m "تحديث المتجر وحفظ التعديلات" >nul 2>&1
git push origin main

echo.
echo =========================================================
if %errorlevel% equ 0 (
    echo [تهانينا!] تم رفع جميع ملفات ومجلدات المتجر بنجاح 100%% إلى GitHub!
    echo الموقع سيتحدث تلقائياً على GitHub Pages خلال لحظات.
) else (
    echo حدث خطأ أثناء الرفع، يرجى التأكد من اتصال الإنترنت.
)
echo =========================================================
pause
